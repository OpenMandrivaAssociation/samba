# One filter, so the source-package lint counts it as used. The obsolete
# warnings are real on the spec; the other names are the dlopen'd nss modules.
addFilter("binary-or-shlib-defines-rpath|tag-not-utf8|devel-file-in-non-devel-package|invalid-soname|incoherent-version-in-name|no-dependency-on|unversioned-explicit-obsoletes")
